{
  "name": "api-ui-testing-node-22-15",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API login with reusable authenticated UI state for Node.js 22.15.0 and installed Google Chrome.",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "verify": "node scripts/verify-environment.js",
    "pretest": "npm run verify",
    "test": "playwright test --project=google-chrome",
    "test:chrome": "playwright test --project=google-chrome",
    "test:headed": "playwright test --project=google-chrome --headed",
    "test:dashboard": "playwright test tests/dashboard.spec.js --project=google-chrome",
    "test:orders": "playwright test tests/orders.spec.js --project=google-chrome",
    "test:list": "playwright test --list",
    "auth": "playwright test --project=setup",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "dotenv": "16.4.7"
  }
}
